@model Product

@{
    ViewData["Title"] = "Modifier le produit";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Catalogue</p>
        <h1>Modifier @Model.Name</h1>
    </div>
    <a class="button" asp-action="Index">Retour</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card form-card" data-validate="true">
    <input asp-for="Id" type="hidden" />
    <partial name="_ProductForm" model="Model" />
    <div class="form-actions">
        <button class="button button-primary" type="submit">Mettre à jour</button>
        <a class="button" asp-action="Index">Annuler</a>
    </div>
</form>
