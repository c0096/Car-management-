@model VehicleSaleDeclaration

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="form-section">
    <h2>Informations du rédacteur</h2>
    <div class="form-grid">
        <label>
            <span asp-for="WriterName"></span>
            <input asp-for="WriterName" />
            <span asp-validation-for="WriterName" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="AuthorizationNumber"></span>
            <input asp-for="AuthorizationNumber" />
            <span asp-validation-for="AuthorizationNumber" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="WriterPhone"></span>
            <input asp-for="WriterPhone" />
            <span asp-validation-for="WriterPhone" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="City"></span>
            <input asp-for="City" />
            <span asp-validation-for="City" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="DeclarationDateTime"></span>
            <input asp-for="DeclarationDateTime" type="datetime-local" value="@Model.DeclarationDateTime.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="DeclarationDateTime" class="field-validation"></span>
        </label>
    </div>
</section>

<section class="form-section">
    <h2>Informations du vendeur</h2>
    <div class="form-grid">
        <label>
            <span asp-for="SellerName"></span>
            <input asp-for="SellerName" />
            <span asp-validation-for="SellerName" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="SellerAddress"></span>
            <input asp-for="SellerAddress" />
            <span asp-validation-for="SellerAddress" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="SellerCin"></span>
            <input asp-for="SellerCin" />
            <span asp-validation-for="SellerCin" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="SellerPhone"></span>
            <input asp-for="SellerPhone" />
            <span asp-validation-for="SellerPhone" class="field-validation"></span>
        </label>
    </div>
</section>

<section class="form-section">
    <h2>Déclaration de vente</h2>
    <div class="form-grid">
        <label>
            <span asp-for="SoldItemDescription"></span>
            <input asp-for="SoldItemDescription" />
            <span asp-validation-for="SoldItemDescription" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="OrderNumber"></span>
            <input asp-for="OrderNumber" />
            <span asp-validation-for="OrderNumber" class="field-validation"></span>
        </label>
    </div>
</section>

<section class="form-section">
    <h2>Informations du véhicule</h2>
    <div class="form-grid">
        <label>
            <span asp-for="VehicleType"></span>
            <input asp-for="VehicleType" />
            <span asp-validation-for="VehicleType" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="VehicleBrand"></span>
            <input asp-for="VehicleBrand" />
            <span asp-validation-for="VehicleBrand" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="ChassisNumber"></span>
            <input asp-for="ChassisNumber" />
            <span asp-validation-for="ChassisNumber" class="field-validation"></span>
        </label>
    </div>
</section>

<section class="form-section">
    <h2>Informations de l'acheteur</h2>
    <div class="form-grid">
        <label>
            <span asp-for="BuyerName"></span>
            <input asp-for="BuyerName" />
            <span asp-validation-for="BuyerName" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="BuyerAddress"></span>
            <input asp-for="BuyerAddress" />
            <span asp-validation-for="BuyerAddress" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="BuyerCin"></span>
            <input asp-for="BuyerCin" />
            <span asp-validation-for="BuyerCin" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="BuyerPhone"></span>
            <input asp-for="BuyerPhone" />
            <span asp-validation-for="BuyerPhone" class="field-validation"></span>
        </label>
    </div>
</section>

<section class="form-section">
    <h2>Documents et métadonnées</h2>
    <div class="form-grid">
        <label>
            <span asp-for="PropertyTitle"></span>
            <input asp-for="PropertyTitle" />
            <span asp-validation-for="PropertyTitle" class="field-validation"></span>
        </label>
        <label>
            <span>Pièces jointes</span>
            <input type="file" name="attachmentFiles" multiple />
        </label>
        <label class="wide-field">
            <span asp-for="Observation"></span>
            <textarea asp-for="Observation" rows="4"></textarea>
            <span asp-validation-for="Observation" class="field-validation"></span>
        </label>
    </div>
    @if (Model.Attachments.Count > 0)
    {
        <div class="attachment-list">
            <strong>Pièces jointes existantes</strong>
            @foreach (var attachment in Model.Attachments)
            {
                <label class="attachment-row">
                    <input type="checkbox" name="removedAttachmentIds" value="@attachment.Id" />
                    <span>Supprimer @attachment.OriginalFileName</span>
                </label>
            }
        </div>
    }
</section>

<section class="form-section">
    <h2>Signatures</h2>
    <div class="form-grid">
        <label>
            <span asp-for="SellerSignature"></span>
            <input asp-for="SellerSignature" />
            <span asp-validation-for="SellerSignature" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="ManagerSignature"></span>
            <input asp-for="ManagerSignature" />
            <span asp-validation-for="ManagerSignature" class="field-validation"></span>
        </label>
        <label>
            <span asp-for="BuyerSignature"></span>
            <input asp-for="BuyerSignature" />
            <span asp-validation-for="BuyerSignature" class="field-validation"></span>
        </label>
    </div>
</section>
